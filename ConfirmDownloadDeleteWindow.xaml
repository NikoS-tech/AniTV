<Window x:Class="AniTV.ConfirmDownloadDeleteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Удалить скачанную серию" Width="490" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#141722" Foreground="#F4F5F8" FontFamily="Segoe UI">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#3D344E" BorderThickness="1" Padding="24,16,24,24"><StackPanel>
    <DockPanel Margin="0,0,0,22"><Button DockPanel.Dock="Right" Content="✕" IsCancel="True" Style="{StaticResource CaptionButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Отмена"/><TextBlock Text="ANI · TV" Foreground="#A78BFA" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
    <Border Background="#342536" CornerRadius="14" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,18"><TextBlock Text="×" Foreground="#E9A5C0" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <TextBlock Text="Удалить скачанную серию?" TextWrapping="Wrap" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <TextBlock x:Name="EpisodeName" FontSize="15" TextWrapping="Wrap" Foreground="#C4B5FD" Margin="0,0,0,20"/>
    <Border Background="#1D2130" CornerRadius="10" Padding="14"><TextBlock Text="Видео будет удалено с диска. История просмотра и отметки просмотренных серий сохранятся." Foreground="#AEB4C6" TextWrapping="Wrap" LineHeight="21"/></Border>
    <Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="CancelButton" Content="Отмена" IsCancel="True" IsDefault="True" Padding="16,12"/><Button Grid.Column="2" Content="Удалить файл" Background="#6F3A61" Click="Confirm_Click" Padding="16,12"/></Grid>
  </StackPanel></Border>
</Window>
